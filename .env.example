# Copy this file to .env and fill in what you have.
# Nothing in this app hardcodes credentials — everything reads from these
# environment variables, and each has an explicit, labeled fallback:
#   - No FINANCIAL_API_KEY  -> DEMO MODE (synthetic data via MockProvider)
#   - No AI_API_KEY         -> AI research assistant endpoint returns 503
#   - No DATABASE_URL       -> local SQLite file (./equitylens.db)

# Financial data provider (e.g. Financial Modeling Prep, Alpha Vantage, etc.)
FINANCIAL_API_KEY=

# Anthropic API key, for the AI research assistant
AI_API_KEY=

# SQLAlchemy connection string. Defaults to SQLite if unset.
# Postgres example: postgresql+psycopg2://user:password@localhost:5432/equitylens
DATABASE_URL=sqlite:///./equitylens.db
